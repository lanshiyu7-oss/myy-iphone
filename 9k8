<script>
  const PASSCODE = "0000";
  let currentInput = "";

  function pressDigit(num) {
    if (currentInput.length >= 4) return;
    currentInput += num;
    updateDots();

    if (currentInput.length === 4) {
      if (currentInput === PASSCODE) {
        setTimeout(() => {
          document.getElementById("lockScreen").classList.add("unlocked");
          currentInput = "";
          updateDots();
        }, 150);
      } else {
        const dotsBox = document.getElementById("passDots");
        const dots = dotsBox.querySelectorAll(".dot");
        dots.forEach(d => d.classList.add("error"));
        dotsBox.classList.add("shake");
        document.getElementById("passPrompt").innerText = "密码错误，请重新输入 (0000)";
        setTimeout(() => {
          currentInput = "";
          dots.forEach(d => d.classList.remove("error"));
          dotsBox.classList.remove("shake");
          updateDots();
        }, 450);
      }
    }
  }

  function clearPass() {
    currentInput = currentInput.slice(0, -1);
    updateDots();
  }

  function updateDots() {
    const dots = document.querySelectorAll("#passDots .dot");
    dots.forEach((dot, idx) => {
      dot.classList.toggle("filled", idx < currentInput.length);
    });
  }

  function lockPhone() {
    closeAllApps();
    document.getElementById("lockScreen").classList.remove("unlocked");
  }

  function openApp(appName) {
    closeAllApps();
    const target = document.getElementById("app-" + appName);
    if (target) {
      target.classList.add("active");
      document.getElementById("statusBar").classList.add("dark-text");
      document.getElementById("homeBar").classList.add("dark");
    }
  }

  function closeAllApps() {
    document.querySelectorAll(".app-window").forEach(win => {
      win.classList.remove("active");
    });
    document.getElementById("statusBar").classList.remove("dark-text");
    document.getElementById("homeBar").classList.remove("dark");
  }

  function toggleTheme() {
    document.getElementById("phoneFrame").classList.toggle("theme-light");
  }
</script>
